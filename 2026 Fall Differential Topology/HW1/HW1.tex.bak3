\question{1.7}{}
Let $N$ denote the \textbf{north pole} $(0,\cdots,0,1)\in \mathbb{S}^n\subseteq \mathbb{R}^{n+1}$, and let $S$ denote the \textbf{south pole} $(0,\cdots,0,-1)$. Define the \textbf{stereographic projection} $\sigma:\mathbb{S}^n\setminus \{N\}\to \mathbb{R}^n$ by
\begin{align}
    \sigma(x_1,\cdots,x_{n+1})=\frac{(x_1,\cdots,x_n)}{1-x_{n+1}}.
\end{align}
Let $\tilde{\sigma}(x)=-\sigma(-x)$ for $x\in \mathbb{S}^n\setminus \{S\}$. 
\begin{itemize}
    \item [(a)] For any $x\in \mathbb{S}^n\setminus \{N\}$, show that $\sigma(x)=u$, where $(u,0)$ is the point where the line through $N$ and $x$ intersects the linear subspace where $x_{n+1}=0$. Similarly, show that $\tilde{\sigma}(x)$ is the point where the line through $S$ and $x$ intersects the same subspace. (For this reason, $\tilde{\sigma}$ is also called $\textbf{stereographic projection from the south pole}$.)  
    \item [(b)] Show that $\sigma$ is bijective and 
    \begin{align}
        \sigma^{-1}(u_1,\cdots,u_n)=\frac{(2u_1,\cdots,2u_n, |u|^2-1)}{|u|^2+1}.
    \end{align}
    \item [(c)] Compute the transition map $\tilde{\sigma}\circ \sigma^{-1}$ and verify that the atlas consisting of the two charts $(\mathbb{S}^n\setminus \{N\},\sigma)$ and $(\mathbb{S}^n\setminus \{S\},\tilde{\sigma})$ defines a smooth structure on $\mathbb{S}^n$. (The coordinates defined by $\sigma$ and $\tilde{\sigma}$ are called \textbf{stereographic coordinates}.)
    \item [(d)] Show that this smooth structure is the same as the one defined in Example~1.31.
\end{itemize}

\textbf{Example 1.31} We put a smooth structure on $\mathbb{S}^n$ as follows. For each $i=1,\cdots,n+1$, let $(U_i^\pm,\phi_i^\pm)$ denote the graph coordinate charts, where 
\begin{align}
    U_i^\pm=\{(x_1,\cdots,x_{n+1})\in \mathbb{S}^n: \pm x_i>0\},\quad \phi_i^\pm(x_1,\cdots,x_{n+1})=(x_1,\cdots,\hat{x}_i,\cdots,x_{n+1}),
\end{align}
where the hat indicates that the $i$-th coordinate is omitted. 


For any distinct indices $i,j$, the transition map $\phi_i^\pm\circ (\phi_j^\pm)^{-1}$ is easily computed. In the case $i<j$, we get 
\begin{align}
    \phi_i^\pm\circ (\phi_j^\pm)^{-1}(u_1,\cdots,u_{n})=(u_1,\cdots,\hat{u}_{i},\cdots,\pm\sqrt{1-|u|^2},\cdots,u_{n})
\end{align}
with the $\pm\sqrt{1-|u|^2}$ in the $j$-th position, and a similar formula holds for $i>j$. In the case $i=j$, an even simpler formula holds:
\begin{align}
    \phi_i^\pm\circ (\phi_i^\mp)^{-1}(u_1,\cdots,u_{n})=\mathrm{ID}_{\mathbb{B}^n}.
\end{align}
Thus, the collection of charts $\{(U_i^\pm,\phi_i^\pm)\}$ is a smooth atlas, and so defines a smooth structure on $\mathbb{S}^n$.

\answer{}
\begin{itemize}
    \item [(a)]
\end{itemize}
Consider the line 
\begin{align}
    \ell(t)=N+t(x-N)=t(x_1,\cdots,x_n,x_{n+1}-1)+(0,\cdots,0,1)=(tx_1,\cdots,tx_n,t(x_{n+1}-1)+1).
\end{align}
Obviously, $\ell(0)=N$ and $\ell(1)=x$. We want to find the point where this line intersects the hyperplane $x_{n+1}=0$. Setting the last coordinate of $\ell(t)$ equal to zero, we have
\begin{align}
    t(x_{n+1}-1)+1=0\implies t=\frac{1}{1-x_{n+1}}.
\end{align}
Plugging this value of $t$ into the first $n$ coordinates of $\ell(t)$, we get
\begin{align}
    \ell\left(t=\frac{1}{1-x_{n+1}}\right)=\frac{(x_1,\cdots,x_n)}{1-x_{n+1}}.
\end{align}
This is exactly the definition of $\sigma(x)$. A similar argument shows that $\tilde{\sigma}(x)$ is the point where the line through $S$ and $x$ intersects the hyperplane $x_{n+1}=0$. More explicitly, consider the line
\begin{align}
    \tilde{\ell}(t)=S+t(x-S)=t(x_1,\cdots,x_n,x_{n+1}+1)+(0,\cdots,0,-1)=(tx_1,\cdots,tx_n,t(x_{n+1}+1)-1).
\end{align}
Setting the last coordinate of $\tilde{\ell}(t)$ equal to zero, we have
\begin{align}
    t(x_{n+1}+1)-1=0\implies t=\frac{1}{1+x_{n+1}}.
\end{align}
Plugging this value of $t$ into the first $n$ coordinates of $\tilde{\ell}(t)$, we get
\begin{align}
    \tilde{\ell}\left(t=\frac{1}{1+x_{n+1}}\right)=\frac{(x_1,\cdots,x_n)}{1+x_{n+1}}.
\end{align}
On the other hand, by the definition of $\tilde{\sigma}$, we have
\begin{align}
    \tilde{\sigma}(x)=-\sigma(-x)=-\frac{(-x_1,\cdots,-x_n)}{1-(-x_{n+1})}=\frac{(x_1,\cdots,x_n)}{1+x_{n+1}}.
\end{align}
These two expressions agree, so $\tilde{\sigma}(x)$ is exactly the point where the line through $S$ and $x$ intersects the hyperplane $x_{n+1}=0$.

\begin{itemize}
    \item [(b)] 
\end{itemize}
In order to show that $\sigma$ is bijective, we will show that it is both injective and surjective. For injectivity, suppose that $\sigma(x)=\sigma(y)$ for some $x,y\in \mathbb{S}^n\setminus \{N\}$. Then we have 
\begin{align}
    \frac{(x_1,\cdots,x_n)}{1-x_{n+1}}=\frac{(y_1,\cdots,y_n)}{1-y_{n+1}}.
\end{align}
Hence, we have 
\begin{align}
    x_i= \frac{1-x_{n+1}}{1-y_{n+1}}y_i\quad \text{for all } i=1,\cdots,n.
\end{align}
Consider the last coordinate of $x$ and $y$. Since both $x$ and $y$ are on the unit sphere, we have 
\begin{align}
    1-x_{n+1}^2=\sum_{i=1}^{n}x_i^2=\sum_{i=1}^{n}\left(\frac{1-x_{n+1}}{1-y_{n+1}}y_i\right)^2=\left(\frac{1-x_{n+1}}{1-y_{n+1}}\right)^2\sum_{i=1}^{n}y_i^2=\left(\frac{1-x_{n+1}}{1-y_{n+1}}\right)^2(1-y_{n+1}^2).
\end{align}
This implies that
\begin{align}
    &1-x_{n+1}^2=\left(\frac{1-x_{n+1}}{1-y_{n+1}}\right)^2(1-y_{n+1}^2)\\
    \implies &(1-x_{n+1})(1+x_{n+1})=\frac{(1-x_{n+1})^2}{(1-y_{n+1})^2}(1-y_{n+1})(1+y_{n+1})\\
    \implies &(1+x_{n+1})(1-y_{n+1})=(1-x_{n+1})(1+y_{n+1})\\
    \implies &1+x_{n+1}-y_{n+1}-x_{n+1}y_{n+1}=1-x_{n+1}+y_{n+1}-x_{n+1}y_{n+1}\\
    \implies &2x_{n+1}=2y_{n+1}\implies x_{n+1}=y_{n+1}.
\end{align}
If $x_{n+1}=y_{n+1}$, then we have
\begin{align}
    x_i= \frac{1-x_{n+1}}{1-y_{n+1}}y_i=y_i\quad \text{for all } i=1,\cdots,n.
\end{align}
Thus, we have shown that $x=y$, and hence $\sigma$ is injective.

Next, in order to show that $\sigma$ is surjective, let $u\in \mathbb{R}^n$ be arbitrary. We want to find $x\in \mathbb{S}^n\setminus \{N\}$ such that $\sigma(x)=u$. Let $x=(x_1,\cdots,x_n,x_{n+1})$. Then we have
\begin{align}
    \sigma(x)=u\implies \frac{(x_1,\cdots,x_n)}{1-x_{n+1}}=u\implies (x_1,\cdots,x_n)=(1-x_{n+1})u=(u_1(1-x_{n+1}),\cdots,u_n(1-x_{n+1})).
\end{align}
With the constraint that $x\in \mathbb{S}^n$, we have
\begin{align}
    1=x_1^2+\cdots+x_n^2+x_{n+1}^2=(1-x_{n+1})^2|u|^2+x_{n+1}^2\implies 1=(1-x_{n+1})^2|u|^2+x_{n+1}^2.
\end{align}
This is a quadratic equation in $x_{n+1}$, which we can simplify as follows:
\begin{align}
    0=(1-x_{n+1})^2|u|^2+x_{n+1}^2-1=(|u|^2+1)x_{n+1}^2-2|u|^2x_{n+1}+|u|^2-1.
\end{align}
Solving for $x_{n+1}$, we have
\begin{align}
    x_{n+1}=\frac{2|u|^2\pm \sqrt{4|u|^4-4(|u|^2+1)(|u|^2-1)}}{2(|u|^2+1)}=\frac{|u|^2\pm 1}{|u|^2+1}.
\end{align}
Since we want $x\in \mathbb{S}^n\setminus \{N\}$, we must have $x_{n+1}\neq 1$, which means that we must take the negative sign in the above expression. Hence, we have 
\begin{align}
    x_{n+1}=\frac{|u|^2-1}{|u|^2+1}.
\end{align}
Now that we have $x_{n+1}$, we can find $x_i$ for $i=1,\cdots,n$:
\begin{align}
    x_i=u_i(1-x_{n+1})=u_i\left(1-\frac{|u|^2-1}{|u|^2+1}\right)=u_i\left(\frac{2}{|u|^2+1}\right)=\frac{2u_i}{|u|^2+1}.
\end{align}
It remains to check that this $x$ indeed has the required properties. First, we have
\begin{align}
    |x|^2=\frac{4|u|^2+(|u|^2-1)^2}{(|u|^2+1)^2}=\frac{|u|^4+2|u|^2+1}{(|u|^2+1)^2}=\frac{(|u|^2+1)^2}{(|u|^2+1)^2}=1,
\end{align}
so $x\in \mathbb{S}^n$. Moreover, $1-x_{n+1}=\frac{2}{|u|^2+1}\neq 0$, so $x\neq N$, and
\begin{align}
    \sigma(x)=\frac{(x_1,\cdots,x_n)}{1-x_{n+1}}=\frac{\frac{2}{|u|^2+1}(u_1,\cdots,u_n)}{\frac{2}{|u|^2+1}}=u.
\end{align}
Thus, we have found $x\in \mathbb{S}^n\setminus \{N\}$ such that $\sigma(x)=u$, and hence $\sigma$ is surjective. Therefore, $\sigma$ is bijective. Besides, we have shown that
\begin{align}
    \sigma^{-1}(u_1,\cdots,u_n)=\frac{(2u_1,\cdots,2u_n, |u|^2-1)}{|u|^2+1}.
\end{align}

\begin{itemize}
    \item [(c)]
\end{itemize}
The transition map $\tilde{\sigma}\circ \sigma^{-1}$ is defined on the image under $\sigma$ of the overlap of the two charts. Since $\sigma^{-1}(u)=S$ if and only if $u=0$, this image is
\begin{align}
    \sigma\big(\mathbb{S}^n\setminus \{N,S\}\big)=\mathbb{R}^n\setminus \{0\}.
\end{align}
For any $u\in \mathbb{R}^n\setminus \{0\}$, using the formula $\tilde{\sigma}(x)=\frac{(x_1,\cdots,x_n)}{1+x_{n+1}}$ obtained in part (a), we have
\begin{align}
    \tilde{\sigma}\circ \sigma^{-1}(u)&=\tilde{\sigma}\left(\frac{(2u_1,\cdots,2u_n, |u|^2-1)}{|u|^2+1}\right)
    =\frac{\frac{1}{|u|^2+1}(2u_1,\cdots,2u_n)}{1+\frac{|u|^2-1}{|u|^2+1}}
    =\frac{(2u_1,\cdots,2u_n)}{2 |u|^2}\\
    &=\frac{(u_1,\cdots,u_n)}{|u|^2}.
\end{align}
Every component of this map is a rational function of $u$ whose denominator $|u|^2$ does not vanish on $\mathbb{R}^n\setminus \{0\}$, and hence $\tilde{\sigma}\circ \sigma^{-1}$ is smooth.

Besides, we need the other transition map $\sigma\circ \tilde{\sigma}^{-1}$ to be smooth as well. Write $f(u)=\frac{u}{|u|^2}$ for the map computed above. Then $|f(u)|=\frac{1}{|u|}$, and hence
\begin{align}
    f(f(u))=\frac{f(u)}{|f(u)|^2}=\frac{u/|u|^2}{1/|u|^2}=u.
\end{align}
Thus $f$ is its own inverse, so
\begin{align}
    \sigma\circ \tilde{\sigma}^{-1}=\left(\tilde{\sigma}\circ \sigma^{-1}\right)^{-1}=f^{-1}=f
\end{align}
is given by the same formula, and is therefore smooth on $\mathbb{R}^n\setminus \{0\}$ as well.

Since $\mathbb{S}^n=(\mathbb{S}^n\setminus \{N\})\cup (\mathbb{S}^n\setminus \{S\})$ and both transition maps are smooth, the atlas consisting of the two charts $(\mathbb{S}^n\setminus \{N\},\sigma)$ and $(\mathbb{S}^n\setminus \{S\},\tilde{\sigma})$ is a smooth atlas, and so defines a smooth structure on $\mathbb{S}^n$.

\begin{itemize}
    \item [(d)]
\end{itemize}

First, we consider the transition map $\phi_i^\pm\circ \sigma^{-1}$. Since $x_i=\frac{2u_i}{|u|^2+1}$ and $|u|^2+1>0$, the condition $\pm x_i>0$ is equivalent to $\pm u_i>0$ for $i=1,\cdots,n$, and the condition $\pm x_{n+1}>0$ is equivalent to $\pm(|u|^2-1)>0$. In either case the domain
\begin{align}
    \sigma\big(U_i^\pm\cap (\mathbb{S}^n\setminus \{N\})\big)
\end{align}
is an open subset of $\mathbb{R}^n$. For $i=1,\cdots,n$ and $u$ in this set, we have 
\begin{align}
    \phi_i^\pm\circ \sigma^{-1}(u)&=\phi_i^\pm\left(\frac{(2u_1,\cdots,2u_n, |u|^2-1)}{|u|^2+1}\right)\\
    &=\left(\frac{2u_1}{|u|^2+1},\cdots,\frac{2u_{i-1}}{|u|^2+1}, \frac{2u_{i+1}}{|u|^2+1}, \cdots, \frac{2u_n}{|u|^2+1},\frac{|u|^2-1}{|u|^2+1}\right),
\end{align}
where the $i$-th coordinate has been omitted. For $i=n+1$, we have
\begin{align}
    \phi_{n+1}^\pm\circ \sigma^{-1}(u)&=\phi_{n+1}^\pm\left(\frac{(2u_1,\cdots,2u_n, |u|^2-1)}{|u|^2+1}\right)
    =\left(\frac{2u_1}{|u|^2+1},\cdots,\frac{2u_n}{|u|^2+1}\right).
\end{align}
In both cases every component is a rational function of $u$ whose denominator $|u|^2+1$ is strictly positive, and hence the transition map is smooth.

Next, we consider the transition map $\sigma\circ (\phi_i^\pm)^{-1}$. On $U_i^\pm$ we have $x_i^2=1-|v|^2>0$, so the image $\phi_i^\pm(U_i^\pm)$ is contained in the open unit ball $\mathbb{B}^n$, on which $\sqrt{1-|v|^2}$ is smooth. For $i=1,\cdots,n$ the north pole $N$ does not lie in $U_i^\pm$, since its $i$-th coordinate is $0$; hence the domain is all of $\mathbb{B}^n$, and
\begin{align}
    \sigma\circ (\phi_i^\pm)^{-1}(v)&=\sigma\left((v_1,\cdots,v_{i-1},\underbrace{\pm\sqrt{1-|v|^2}}_{\text{the $i$-th coordinate}},v_i,\cdots,v_n)\right)\\
    &=\frac{1}{1-v_n}\left(v_1,\cdots,v_{i-1},\pm\sqrt{1-|v|^2},v_i,\cdots,v_{n-1}\right).
\end{align}
Since $|v|<1$ forces $|v_n|<1$, the denominator $1-v_n$ never vanishes, and hence this map is smooth. For $i=n+1$, we have
\begin{align}
    \sigma\circ (\phi_{n+1}^\pm)^{-1}(v)&=\sigma\left((v_1,\cdots,v_n,\underbrace{\pm\sqrt{1-|v|^2}}_{\text{the $(n+1)$-th coordinate}})\right)
    =\frac{1}{1\mp\sqrt{1-|v|^2}}\left(v_1,\cdots,v_n\right).
\end{align}
Here $N=(0,\cdots,0,1)\in U_{n+1}^+$ and $\phi_{n+1}^+(N)=0$, so for the $+$ sign the domain is the punctured ball
\begin{align}
    \phi_{n+1}^+\big(U_{n+1}^+\cap (\mathbb{S}^n\setminus \{N\})\big)=\mathbb{B}^n\setminus \{0\},
\end{align}
on which $1-\sqrt{1-|v|^2}>0$. For the $-$ sign the domain is all of $\mathbb{B}^n$, and $1+\sqrt{1-|v|^2}\geq 1>0$. In both cases the denominator does not vanish, and hence the transition map is smooth.

Last, from $\tilde{\sigma}(x)=-\sigma(-x)$ we obtain $\tilde{\sigma}^{-1}(u)=-\sigma^{-1}(-u)$, that is,
\begin{align}
    \tilde{\sigma}^{-1}(u_1,\cdots,u_n)=\frac{(2u_1,\cdots,2u_n,\,1-|u|^2)}{|u|^2+1},
\end{align}
which differs from $\sigma^{-1}$ only in the sign of the last coordinate. Likewise $\tilde{\sigma}(x)=\frac{(x_1,\cdots,x_n)}{1+x_{n+1}}$ differs from $\sigma$ only in the sign appearing in the denominator. Hence the computations above go through verbatim, with the roles of the $+$ and $-$ signs interchanged in the case $i=n+1$, since it is now $S=(0,\cdots,0,-1)\in U_{n+1}^-$ that has to be removed. Therefore both $\phi_i^\pm\circ \tilde{\sigma}^{-1}$ and $\tilde{\sigma}\circ (\phi_i^\pm)^{-1}$ are smooth.

Therefore, the smooth structure defined by stereographic coordinates is the same as the one defined in Example~1.31.





\clearpage
\question{1.9}{}
\textbf{Complex projective $n$-space}, denoted by $\mathbb{CP}^n$, is the set of all 1-dimensional complex-linear subspaces of $\mathbb{C}^{n+1}$, with the quotient topology inherited from the natural projection $\pi:\mathbb{C}^{n+1}\setminus \{0\}\to \mathbb{CP}^n$. Show that $\mathbb{CP}^n$ is a compact $2n$-dimensional topological manifold, and show how to give it a smooth structure analogous to the one we constructed for $\mathbb{RP}^n$. (We use the correspondence
\begin{align}
    (x_1+iy_1,\cdots,x_{n+1}+iy_{n+1}) \longleftrightarrow (x_1,\cdots,x_{n+1},y_1,\cdots,y_{n+1})
\end{align}
to identify $\mathbb{C}^{n+1}$ with $\mathbb{R}^{2n+2}$.)

\answer{}
We denote the equivalence class of $(z_1,\cdots,z_{n+1})\in \mathbb{C}^{n+1}\setminus \{0\}$ by $[z_1:\cdots:z_{n+1}]$. Then we have
\begin{align}
    [z_1:\cdots:z_{n+1}]=[w_1:\cdots:w_{n+1}]\iff \exists \lambda\in \mathbb{C}\setminus \{0\} \text{ such that } (z_1,\cdots,z_{n+1})=\lambda(w_1,\cdots,w_{n+1}).
\end{align}
The natural projection $\pi:\mathbb{C}^{n+1}\setminus \{0\}\to \mathbb{CP}^n$ is defined by
\begin{align}
    \pi(z_1,\cdots,z_{n+1})=[z_1:\cdots:z_{n+1}]\in \mathbb{CP}^n.
\end{align}
In order to show that $\mathbb{CP}^n$ is a compact $2n$-dimensional topological manifold, we have to show that it is locally Euclidean of dimension $2n$, Hausdorff, second countable, and compact. We then construct a smooth structure on it. 


\paragraph{Locally Euclidean of dimension $2n$: }
For each $i=1,\cdots,n+1$, consider the set
\begin{align}
    U_i=\{[z_1:\cdots:z_{n+1}]\in \mathbb{CP}^n: z_i\neq 0\}.
\end{align}
The set $U_i$ is well-defined, since if $(z_1,\cdots,z_{n+1})=\lambda(w_1,\cdots,w_{n+1})$ for some $\lambda\in \mathbb{C}\setminus \{0\}$, then $z_i\neq 0$ if and only if $w_i\neq 0$. Moreover, $U_i$ is open in $\mathbb{CP}^n$. Indeed, its preimage
\begin{align}
    \Omega_i:=\pi^{-1}(U_i)=\{(z_1,\cdots,z_{n+1})\in \mathbb{C}^{n+1}\setminus \{0\}: z_i\neq 0\}
\end{align}
is the complement of the closed set $\{z_i=0\}$, hence open in $\mathbb{C}^{n+1}\setminus \{0\}$, and by the definition of the quotient topology this means precisely that $U_i$ is open in $\mathbb{CP}^n$.

We define the maps $\phi_i:U_i\to \mathbb{C}^n\cong \mathbb{R}^{2n}$ by
\begin{align}
    \phi_i([z_1:\cdots:z_{n+1}])=\left(\frac{z_1}{z_i},\cdots,\frac{z_{i-1}}{z_i},\frac{z_{i+1}}{z_i},\cdots,\frac{z_{n+1}}{z_i}\right),
\end{align}
where we identify $\mathbb{C}^n$ with $\mathbb{R}^{2n}$ by the correspondence given in the statement of the problem. The map $\phi_i$ is well-defined, since if $[z_1:\cdots:z_{n+1}]=[w_1:\cdots:w_{n+1}]$, then there exists $\lambda\in \mathbb{C}\setminus \{0\}$ such that $(z_1,\cdots,z_{n+1})=\lambda(w_1,\cdots,w_{n+1})$, and hence
\begin{align}
    \frac{z_j}{z_i}=\frac{\lambda w_j}{\lambda w_i}=\frac{w_j}{w_i}\quad \text{for all } j\neq i.
\end{align}
Therefore, $\phi_i$ is well-defined. The map $\phi_i$ is bijective, with inverse given by the map
\begin{align}
    \psi_i(w_1,\cdots,w_n)=[w_1:\cdots:w_{i-1}:1:w_i:\cdots:w_n].
\end{align}
Indeed, on the one hand,
\begin{align}
    \phi_i(\psi_i(w_1,\cdots,w_n))=\left(\frac{w_1}{1},\cdots,\frac{w_{i-1}}{1},\frac{w_i}{1},\cdots,\frac{w_n}{1}\right)=(w_1,\cdots,w_n),
\end{align}
and on the other hand,
\begin{align}
    \psi_i(\phi_i([z_1:\cdots:z_{n+1}]))=\left[\frac{z_1}{z_i}:\cdots:\frac{z_{i-1}}{z_i}:1:\frac{z_{i+1}}{z_i}:\cdots:\frac{z_{n+1}}{z_i}\right]=[z_1:\cdots:z_{n+1}],
\end{align}
where the last equality follows from multiplying every entry by $z_i\neq 0$. Hence $\phi_i^{-1}=\psi_i$.

Now we want to show that $\phi_i$ and $\phi_i^{-1}$ are continuous, and then $\phi_i$ will be a homeomorphism. Consider the map $\tilde{\phi}_i:\Omega_i\to \mathbb{C}^n$ defined by 
\begin{align}
    \tilde{\phi}_i(z_1,\cdots,z_{n+1})=\left(\frac{z_1}{z_i},\cdots,\frac{z_{i-1}}{z_i},\frac{z_{i+1}}{z_i},\cdots,\frac{z_{n+1}}{z_i}\right).
\end{align}
Note that $\tilde{\phi}_i$ is defined on $\Omega_i$ rather than on all of $\mathbb{C}^{n+1}\setminus \{0\}$, since the formula requires $z_i\neq 0$. On $\Omega_i$ each component of $\tilde{\phi}_i$ is a quotient of continuous functions whose denominator does not vanish, and hence $\tilde{\phi}_i$ is continuous. By the definition of $\phi_i$ we have $\tilde{\phi}_i=\phi_i\circ \pi$ on $\Omega_i$, so for any open set $V\subseteq \mathbb{C}^n$,
\begin{align}
    \pi^{-1}\left(\phi_i^{-1}(V)\right)=(\phi_i\circ \pi)^{-1}(V)=\tilde{\phi}_i^{-1}(V).
\end{align}
Since $\tilde{\phi}_i$ is continuous and $V$ is open, the set $\tilde{\phi}_i^{-1}(V)$ is open in $\Omega_i$, and since $\Omega_i$ is open in $\mathbb{C}^{n+1}\setminus \{0\}$, it is open in $\mathbb{C}^{n+1}\setminus \{0\}$ as well. By the definition of the quotient topology, $\phi_i^{-1}(V)$ is open in $\mathbb{CP}^n$. As $V$ was an arbitrary open set, $\phi_i$ is continuous.

For the inverse, consider the map $s_i:\mathbb{C}^n\to \mathbb{C}^{n+1}\setminus \{0\}$ defined by
\begin{align}
    s_i(w_1,\cdots,w_n)=(w_1,\cdots,w_{i-1},1,w_i,\cdots,w_n).
\end{align}
The map $s_i$ is continuous, and its image really does lie in $\mathbb{C}^{n+1}\setminus \{0\}$, since its $i$-th entry is always equal to $1$. Since $\phi_i^{-1}=\pi\circ s_i$ and both $s_i$ and $\pi$ are continuous, the map $\phi_i^{-1}$ is continuous as well.

Therefore, the maps $\phi_i$ and $\phi_i^{-1}$ are both continuous, and hence $\phi_i$ is a homeomorphism from $U_i$ onto $\mathbb{C}^n\cong \mathbb{R}^{2n}$.

Finally, the collection $\{U_i\}_{i=1}^{n+1}$ covers $\mathbb{CP}^n$. Indeed, given any $[z_1:\cdots:z_{n+1}]\in \mathbb{CP}^n$, its representative $(z_1,\cdots,z_{n+1})$ is nonzero, so $z_i\neq 0$ for at least one index $i$, and hence $[z_1:\cdots:z_{n+1}]\in U_i$. Since every point of $\mathbb{CP}^n$ thus has an open neighborhood homeomorphic to $\mathbb{R}^{2n}$, the space $\mathbb{CP}^n$ is locally Euclidean of dimension $2n$.


\paragraph{Hausdorff property: }
A topological space $X$ is Hausdorff if for any $x \neq y\in X$, there exist open sets $U_x$ and $U_y$ containing $x$ and $y$ respectively such that $U_x\cap U_y=\emptyset$. 

Now we consider the space $\mathbb{CP}^n$. Let $[z_1:\cdots:z_{n+1}]\neq [w_1:\cdots:w_{n+1}]$ be two distinct points in $\mathbb{CP}^n$. Then there exists no $\lambda\in \mathbb{C}\setminus \{0\}$ such that $(z_1,\cdots,z_{n+1})=\lambda(w_1,\cdots,w_{n+1})$. This means that the vectors $(z_1,\cdots,z_{n+1})$ and $(w_1,\cdots,w_{n+1})$ are linearly independent in $\mathbb{C}^{n+1}$.
Since $\mathbb{C}^{n+1}$ is a Hausdorff space, there exist open sets $V_z$ and $V_w$ in $\mathbb{C}^{n+1}$ containing $(z_1,\cdots,z_{n+1})$ and $(w_1,\cdots,w_{n+1})$ respectively such that $V_z\  \cap V_w=\emptyset$. We can assume that $V_z$ and $V_w$ are open balls centered at $(z_1,\cdots,z_{n+1})$ and $(w_1,\cdots,w_{n+1})$ respectively.
Now consider the open sets $U_z=\pi(V_z\setminus \{0\})$ and $U_w=\pi(V_w\setminus \{0\})$ in $\mathbb{CP}^n$. We claim that $U_z\cap U_w=\emptyset$. Suppose not, then there exists a point $[u_1:\cdots:u_{n+1}]\in U_z\cap U_w$. Then there exist $\lambda_1,\lambda_2\in \mathbb{C}\setminus \{0\}$ such that $(u_1,\cdots,u_{n+1})=\lambda_1(z_1,\cdots,z_{n+1})=\lambda_2(w_1,\cdots,w_{n+1})$. This implies that $(z_1,\cdots,z_{n+1})$ and $(w_1,\cdots,w_{n+1})$ are linearly dependent, which is a contradiction. Hence $U_z\cap U_w=\emptyset$, and $\mathbb{CP}^n$ is Hausdorff.



\paragraph{Second countable: }
A topological space $(X,\mathcal{T})$ is second countable if there exists a countable subcollection $\mathcal{T}_0$ of $\mathcal{T}$ such that any open set $U\in \mathcal{T}$ is a union of open sets in $\mathcal{T}_0$.

Consider the space $\mathbb{CP}^n$. Since $\mathbb{C}^{n+1}$ is second countable, there exists a countable basis $\mathcal{B}$ for the topology of $\mathbb{C}^{n+1}$. Let $\mathcal{B}'=\{B\setminus \{0\}: B\in \mathcal{B}\}$, which is also countable. Then we can define a collection of open sets in $\mathbb{CP}^n$ as follows:
\begin{align}
    \mathcal{B}''=\{\pi(B\setminus \{0\}): B\in \mathcal{B}\}.
\end{align}
We claim that $\mathcal{B}''$ is a countable basis for the topology of $\mathbb{CP}^n$. Indeed, for any open set $U\subset \mathbb{CP}^n$, its preimage $\pi^{-1}(U)$ is open in $\mathbb{C}^{n+1}\setminus \{0\}$, and hence can be expressed as a union of open sets in $\mathcal{B}'$. Therefore, we have
\begin{align}
    U=\pi(\pi^{-1}(U))=\pi\left(\bigcup_{B\in \mathcal{B}', B\subseteq \pi^{-1}(U)} B\right)=\bigcup_{B\in \mathcal{B}', B\subseteq \pi^{-1}(U)} \pi(B),
\end{align}
which is a union of open sets in $\mathcal{B}''$. Hence $\mathcal{B}''$ is a countable basis for the topology of $\mathbb{CP}^n$, and $\mathbb{CP}^n$ is second countable.

\paragraph{Compactness: }
C0nsider the unit sphere $S^{2n+1}=\{(z_1,\cdots,z_{n+1})\in \mathbb{C}^{n+1}: |z_1|^2+\cdots+|z_{n+1}|^2=1\}$ in $\mathbb{C}^{n+1}$. The sphere $S^{2n+1}$ is compact, and the natural projection $\pi:S^{2n+1}\to \mathbb{CP}^n$ is continuous and surjective. Since the continuous image of a compact space is compact, it follows that $\mathbb{CP}^n$ is compact.



\paragraph{Smooth structure: }
Now, we construct a smooth structure on $\mathbb{CP}^n$ analogous to the one we constructed for $\mathbb{RP}^n$. For each $i=1,\cdots,n+1$, we define the map $\phi_i:U_i\to \mathbb{C}^n\cong \mathbb{R}^{2n}$ by
\begin{align}
    \phi_i([z_1:\cdots:z_{n+1}])=\left(\frac{z_1}{z_i},\cdots,\frac{z_{i-1}}{z_i},\frac{z_{i+1}}{z_i},\cdots,\frac{z_{n+1}}{z_i}\right).
\end{align}
Then, the collection of charts $\{(U_i,\phi_i)\}_{i=1}^{n+1}$ forms an atlas for $\mathbb{CP}^n$. To show that this atlas defines a smooth structure, we need to check that the transition maps are smooth.
For $i,j\in \{1,\cdots,n+1\}$ with $i\neq j$, the transition map $\phi_j\circ \phi_i^{-1}:\\phi_i(U_i\cap U_j)\to \phi_j(U_i\cap U_j)$ is given by
\begin{align}
    \phi_j\circ \phi_i^{-1}(w_1,\cdots,w_n)=\left(\frac{w_1}{w_j},\cdots,\frac{w_{j-1}}{w_j},\frac{1}{w_j},\frac{w_{j+1}}{w_j},\cdots,\frac{w_n}{w_j}\right),
\end{align}
where $w_j$ is the $j$-th coordinate of $(w_1,\cdots,w_n)$ in the domain of the transition map. Each component of this map is a rational function of the coordinates $w_1,\cdots,w_n$ whose denominator $w_j$ does not vanish on the domain $\phi_i(U_i\cap U_j)$, and hence the transition map is smooth. Since all transition maps are smooth, the atlas $\{(U_i,\phi_i)\}_{i=1}^{n+1}$ defines a smooth structure on $\mathbb{CP}^n$.






